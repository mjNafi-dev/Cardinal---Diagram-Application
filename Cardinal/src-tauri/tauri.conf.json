{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cardinal",
  "version": "0.2.0",
  "identifier": "app.cardinal.diagrams",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5177",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cardinal",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Mahir Jabid Nafi",
    "category": "Productivity",
    "shortDescription": "Offline ER diagrams and logic circuits",
    "longDescription": "Cardinal draws Crow's Foot and Chen/EER database diagrams with self-routing lines and two-way SQL, plus logic circuits with live simulation and truth tables. Everything stays on your computer.",
    "copyright": "© 2026 Mahir Jabid Nafi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
